# Internexis Frontend Environment Configuration
# Copy this file to .env and configure your values

# Application Configuration
VITE_APP_NAME=Internexis Technologies
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Campus Ambassador & Internship Platform

# Contact Information
VITE_CONTACT_EMAIL=contact@internexis-technologies.in

# Analytics (optional)
VITE_GOOGLE_ANALYTICS_ID=your_ga_id_here

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_ANIMATIONS=true
VITE_ENABLE_PWA=false

# External Services (optional)
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here
VITE_MAPS_API_KEY=your_maps_api_key_here

# Email Configuration
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Development Settings
VITE_DEV_MODE=true
VITE_SHOW_CONSOLE_LOGS=true

# Social Media Links
VITE_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61576033436313
VITE_LINKEDIN_URL=https://www.linkedin.com/company/internexis-technologies
VITE_TWITTER_URL=https://twitter.com/interneexi26846
VITE_INSTAGRAM_URL=https://www.instagram.com/internexistechnologies
