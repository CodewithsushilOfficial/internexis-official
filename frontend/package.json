{
  "name": "internexis-frontend",
  "version": "1.0.0",
  "description": "Internexis Frontend Application - React + TypeScript + Vite + Tailwind CSS",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "NODE_ENV=production vite build",
    "build:check": "tsc --noEmit && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run lint && npm run build:production"
  },
  "keywords": [
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "frontend",
    "internship",
    "campus-ambassador",
    "career"
  ],
  "author": "Internexis Technologies Pvt Ltd",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-tabs": "^1.1.9",
    "@react-three/drei": "^9.99.0",
    "@react-three/fiber": "^8.15.16",
    "@react-three/postprocessing": "^2.7.0",
    "aos": "^2.3.4",
    "framer-motion": "^11.0.5",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.344.0",
    "postprocessing": "^6.37.3",
    "react": "^18.3.1",
    "react-countup": "^6.5.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.5.3",
    "recharts": "^2.15.3",
    "swiper": "^11.0.6",
    "three": "^0.161.0"
  },  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/aos": "^3.0.7",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.161.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^6.3.4",
    "vitest": "^3.2.3"
  }
}
