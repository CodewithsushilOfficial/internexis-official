# Internexis Frontend Development Environment Configuration

# Application Configuration
VITE_APP_NAME=Internexis Technologies
VITE_APP_VERSION=2.0.0
VITE_APP_DESCRIPTION=Virtual Internship Platform

# Backend API Configuration (Development)
VITE_API_BASE_URL=http://localhost:5001
