# Frontend Environment Variables - Development
VITE_API_URL=http://localhost:5000
VITE_APP_NAME=Internexis Technologies
VITE_APP_VERSION=2.0.0
VITE_APP_DESCRIPTION=Leading platform for internships, career guidance, and professional development

# API Configuration
VITE_API_TIMEOUT=10000
VITE_API_RETRY_ATTEMPTS=3

# Authentication
VITE_JWT_STORAGE_KEY=internexis_admin_token
VITE_TOKEN_REFRESH_INTERVAL=300000

# Features
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Social Media Links
VITE_LINKEDIN_URL=https://linkedin.com/company/internexis-technologies
VITE_TWITTER_URL=https://twitter.com/internexis
VITE_INSTAGRAM_URL=https://instagram.com/internexis_technologies
VITE_GITHUB_URL=https://github.com/internexis

# Contact Information
VITE_CONTACT_EMAIL=help.internexis@gmail.com
VITE_CONTACT_PHONE=+91-9214267778
VITE_WHATSAPP_NUMBER=+91-9214267778

# File Upload
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png

# Email Configuration (for EmailJS)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Development Tools
VITE_ENABLE_DEV_TOOLS=true
VITE_SHOW_CONSOLE_LOGS=true
